      "credentials": { "anthropicApi": { "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "modelId": "claude-opus-4-8",
        "messages": { "values": [
          { "role": "system", "content": "You are a technical writer. Turn the notes into a tight 150-word paragraph." },
          { "role": "user", "content": "=Notes:\n{{$json.text}}" }
        ] },
        "options": { "maxTokens": 600 }
      },
      "id": "a7000000-0000-0000-0000-000000000003",
      "name": "Agent 2: Writer",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": { "anthropicApi": { "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "modelId": "claude-opus-4-8",
        "messages": { "values": [
          { "role": "system", "content": "You are an editor. Improve clarity, flag unsupported claims, and return the final text." },
          { "role": "user", "content": "=Draft:\n{{$json.text}}" }
        ] },
        "options": { "maxTokens": 600 }
      },
      "id": "a7000000-0000-0000-0000-000000000004",
      "name": "Agent 3: Reviewer",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": { "anthropicApi": { "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID", "name": "Anthropic account" } }
    },
    {
